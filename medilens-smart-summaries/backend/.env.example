# ─────────────────────────────────────────────────────────────
# MediLens Backend — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# --- Database ---
# SQLite (default, works out of the box — no extra setup):
DATABASE_URL=sqlite:///./medilens.db

# PostgreSQL / Supabase (uncomment to switch):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/medilens

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_a_64_char_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI (optional) ---
# Leave blank to use the offline rule-based summarizer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- OCR ---
# Only needed on Windows if Tesseract is not on PATH.
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- File uploads ---
UPLOAD_DIR=./uploads

# --- Email / SMTP (optional — for password-reset emails) ---
# Leave blank to print OTP codes to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medilens.local
